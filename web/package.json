{
  "name": "scorad-web",
  "version": "1.0.0",
  "private": true,
  "description": "SCORAD 评估工具 Web 端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && npm run test:bundle",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bundle": "node scripts/check-bundle-size.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.3",
    "echarts": "^6.1.0",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@pinia/testing": "0.1.7",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^28.1.0",
    "typescript": "^5.5.4",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.1.6"
  }
}
